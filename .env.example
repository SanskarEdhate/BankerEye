# Flask API Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_API_BASE_URL=http://127.0.0.1:5000

# Dataset Path (default uses dataset/bank-full.csv)
DATASET_PATH=dataset/bank-full.csv
